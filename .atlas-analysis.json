  "keyFeatures": [
    "Agent identity registry with KYA (Know Your Agent) verification",
    "Mandate-based spending policies with per-transaction and total budget limits",
    "Real-time policy enforcement engine with 9 configurable checks",
    "x402 payment protocol support with USDC on Base mainnet",
    "Sandbox environment for testing payment flows end-to-end",
    "Server-side middleware for Hono and Express (5-line integration)",
    "TypeScript SDK for agent developers to handle 402 payment flows automatically",
    "Transaction history and audit log with tamper-evident records",
    "Dashboard for managing agents, mandates, merchants, and API keys"
  ],
