          },
          "supabase_user_id": {
            "type": "string",
            "title": "Supabase User Id",
            "example": "user-123e4567-e89b-12d3-a456-426614174000"
          }
        },
        "type": "object",
        "required": [
          "name",
          "email",
          "supabase_user_id"
        ],
        "title": "CreateAccountRequest"
      },
      "CreateAgentRequest": {
        "properties": {
