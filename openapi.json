          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "example": "Fetches company data from financial APIs"
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Capabilities",
            "default": [],
            "example": [
              "data-fetch",
              "financial-research"
            ]
          }
        },
        "type": "object",
        "required": [
